# SQLite database (local development)
DATABASE_URL="file:./dev.db"

# AI provider chain — free tiers only by default (no billing)
# Tries each keyed provider in order when one hits quota/rate limits.
# Entries without API keys are skipped. Settings → AI shows which keys are active.
# Tip: set GROQ_API_KEY and/or OPENROUTER_API_KEY so Gemini quota exhaustion
# still yields ChatGPT-level quizzes/Six lessons instead of offline fallbacks only.
AI_PROVIDER_CHAIN=gemini,groq,openrouter

# Google Gemini — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL=gemini-2.5-flash

# Groq — free tier at https://console.groq.com/keys (recommended failover)
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free :free models at https://openrouter.ai/settings/keys (recommended failover)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=google/gemini-2.5-flash
# Vision OCR for syllabus/photo cold start (used when Gemini is unavailable)
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Legacy single-provider override (optional). Prefer AI_PROVIDER_CHAIN.
# AI_PROVIDER=gemini

# OpenAI — optional Pro only. Not in the default free chain.
# Enable in Settings → “Use OpenAI as Pro fallback”, or add openai to
# AI_PROVIDER_CHAIN / set AI_PROVIDER=openai.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL=gpt-4o-mini

# Phase 2D-2 — SIX Tutor → Unified Tutor facade (default OFF = legacy path)
# STUDY_HAUL_SIX_TUTOR_UNIFIED=1

# Phase 2D-3 — CORE Assist → Unified Tutor facade (default OFF = legacy path)
# STUDY_HAUL_CORE_ASSIST_UNIFIED=1

# Phase 2D-4 — Teach Me evaluate → Unified Tutor facade (default OFF = legacy path)
# STUDY_HAUL_TEACH_ME_UNIFIED=1

# Phase 2E-1 — CORE Note study extract → Knowledge Model Concepts (default OFF)
# STUDY_HAUL_CORE_KNOWLEDGE_BRIDGE=1

# Phase 2E-2 — Concept↔Concept relationship foundation (default OFF)
# STUDY_HAUL_CONCEPT_RELATIONSHIPS=1

# Phase 2E-3 — Orchestrator direct-prerequisite awareness (default OFF; separate from storage)
# STUDY_HAUL_ORCHESTRATOR_PREREQUISITES=1

# Phase 2F-2 — LearningAttempt evidence aggregation / Learner Model signals (default OFF)
# STUDY_HAUL_EVIDENCE_INTELLIGENCE=1

# Session signing secret (change in production)
# REQUIRED in production — weak/missing values are rejected when NODE_ENV=production.
# Also used to seal LMS/OAuth tokens at rest (AES-256-GCM). Changing it invalidates sealed tokens.
SESSION_SECRET="generate-a-long-random-string"

# Optional: force Secure cookie flag. Do not set to "false" on HTTPS production.
# SESSION_COOKIE_SECURE=true

# Emergency Docker schema only — allows prisma db push --accept-data-loss
# ALLOW_DB_DATA_LOSS=0

# Persistent data directory (production: /data on Fly.io volume)
# DATA_DIR="/data"

# App URL — required for OAuth; use your public URL when deployed
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canvas LMS OAuth (optional)
CANVAS_CLIENT_ID=""
CANVAS_CLIENT_SECRET=""

# Google OAuth (sign-in, Classroom, Calendar two-way sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Authorized redirect URIs in Google Cloud Console:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   {NEXT_PUBLIC_APP_URL}/api/calendar/google/oauth/callback
#   {NEXT_PUBLIC_APP_URL}/api/lms/oauth/callback
# Calendar OAuth requests calendar.events + calendarlist.readonly scopes.
# Reconnect Google Calendar after upgrading from read-only sync.

# Blackboard Learn OAuth (optional)
BLACKBOARD_CLIENT_ID=""
BLACKBOARD_CLIENT_SECRET=""
# CLI test: npx tsx scripts/test-blackboard.ts
BLACKBOARD_BASE_URL=""
BLACKBOARD_ACCESS_TOKEN=""

# Moodle Web Services (optional — for local dev / audit scripts)
# Site root only, e.g. https://moodle.lsua.edu (not the token page URL)
MOODLE_URL=""
MOODLE_TOKEN=""
