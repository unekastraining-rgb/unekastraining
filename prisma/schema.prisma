// CSL Academic Ecosystem — foundational data model

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum MaterialType {
  SYLLABUS
  LECTURE_SLIDES
  TEXTBOOK
  VIDEO
  ARTICLE
  DOCUMENT
  OTHER
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
  OVERDUE
}

enum StudyActivityType {
  READING
  FLASHCARDS
  NOTES_REVIEW
  PRACTICE
  ASSIGNMENT
  GENERAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses        Course[]
  notes          Note[]
  topicMasteries TopicMastery[]
  flashcards     Flashcard[]
  studySessions  StudySession[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  code        String?
  instructor  String?
  description String?
  semester    String?
  color       String?  @default("#6366f1")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials     CourseMaterial[]
  assignments   Assignment[]
  topics        Topic[]
  notes         Note[]
  studySessions StudySession[]

  @@unique([userId, code])
  @@index([userId])
}

model CourseMaterial {
  id            String       @id @default(cuid())
  title         String
  type          MaterialType @default(OTHER)
  url           String?
  filePath      String?
  extractedText String?
  sortOrder     Int          @default(0)
  courseId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      AssignmentStatus @default(NOT_STARTED)
  grade       Float?
  maxGrade    Float?
  courseId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dueDate])
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  courseId    String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent        Topic?          @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Topic[]         @relation("TopicHierarchy")
  notes         Note[]
  masteries     TopicMastery[]
  flashcards    Flashcard[]
  studySessions StudySession[]

  @@index([courseId])
  @@index([parentId])
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  content   String
  isPinned  Boolean  @default(false)
  userId    String
  courseId  String?
  topicId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic  Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([topicId])
}

model TopicMastery {
  id             String    @id @default(cuid())
  userId         String
  topicId        String
  proficiency    Float     @default(0)
  confidence     Float     @default(0)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@index([nextReviewAt])
}

model Flashcard {
  id           String    @id @default(cuid())
  front        String
  back         String
  difficulty   Float     @default(2.5)
  interval     Int       @default(0)
  repetitions  Int       @default(0)
  nextReviewAt DateTime?
  userId       String
  topicId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([nextReviewAt])
}

model StudySession {
  id              String            @id @default(cuid())
  userId          String
  courseId        String?
  topicId         String?
  activityType    StudyActivityType @default(GENERAL)
  durationSeconds Int               @default(0)
  cardsReviewed   Int               @default(0)
  notesCreated    Int               @default(0)
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime          @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic  Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([topicId])
  @@index([startedAt])
}
